# Terraform local state and cache — never commit these
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfplan

# tfvars often contain secrets — exclude by default
# Commit terraform.tfvars.example files only, never terraform.tfvars
terraform.tfvars
*.auto.tfvars

# Lambda build artifacts — regenerated by scripts/build.py at apply time
modules/seeder/lambda/package/*
!modules/seeder/lambda/package/.gitkeep
modules/seeder/lambda_package.zip

# Written by terraform_data.invoke_seeder after each apply
modules/seeder/invoke_response.json

# VPN client configuration — contains credentials (endpoint config + embedded cert/key)
client-config.ovpn

# macOS
.DS_Store

# Claude Code — personal session settings, not team config
.claude/settings.local.json

# Editor
.vscode/
.idea/
*.swp

# Personal notes
next-claude-prompts.md
